# ── Database ──────────────────────────────────────────────────────────────────
# Standard PostgreSQL connection string (Supabase/Neon/any hosted Postgres)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://user:password@host:5432/warranty_radar

# ── Encryption ───────────────────────────────────────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=your-base64-fernet-key-here

# ── Google OAuth 2.0 ─────────────────────────────────────────────────────────
# Create credentials at: https://console.cloud.google.com → APIs & Services → Credentials
# Application type: Web application
# Authorised redirect URIs: http://localhost:8000/auth/gmail/callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/gmail/callback

# ── Google Gemini API (LLM extraction fallback + warranty agent) ──────────────
# Get your key at: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=AIza...your-gemini-api-key-here

# ── CORS ─────────────────────────────────────────────────────────────────────
# Frontend dev server origin — no trailing slash
FRONTEND_ORIGIN=http://localhost:5173

# ── App settings ─────────────────────────────────────────────────────────────
# Directory where uploaded files are saved (relative to backend/)
UPLOAD_DIR=uploads

# ── OCR (Windows only) ───────────────────────────────────────────────────────
# Path to Poppler bin/ directory for pdf2image (skip on Linux/macOS if on PATH)
# POPPLER_PATH=C:\poppler-24.08.0\Library\bin

# ── Milestone 5: Deployment ───────────────────────────────────────────────────
# Additional allowed CORS origins (comma-separated) for production deployments
# EXTRA_FRONTEND_ORIGINS=https://warranty-radar.vercel.app,https://your-custom-domain.com
