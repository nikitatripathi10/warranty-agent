# ── Database ──────────────────────────────────────────────────────────────────
# Standard PostgreSQL connection string (Supabase/Neon/any hosted Postgres)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://user:password@host:5432/warranty_radar

# ── Encryption ───────────────────────────────────────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=your-base64-fernet-key-here

# ── Google OAuth 2.0 ─────────────────────────────────────────────────────────
# Create credentials at: https://console.cloud.google.com → APIs & Services → Credentials
# Application type: Web application
# Authorised redirect URIs: http://localhost:8000/auth/gmail/callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/gmail/callback

# ── Google Gemini API (LLM extraction fallback + warranty agent) ──────────────
# Get your key at: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=AIza...your-gemini-api-key-here

# ── CORS ─────────────────────────────────────────────────────────────────────
# Frontend dev server origin — no trailing slash
FRONTEND_ORIGIN=http://localhost:5173

# ── App settings ─────────────────────────────────────────────────────────────
# Directory where uploaded files are saved (relative to backend/)
UPLOAD_DIR=uploads

# ── OCR (Windows only) ───────────────────────────────────────────────────────
# Path to Poppler bin/ directory for pdf2image (skip on Linux/macOS if on PATH)
# POPPLER_PATH=C:\poppler-24.08.0\Library\bin

# ── Milestone 5: Deployment ───────────────────────────────────────────────────
# Additional allowed CORS origins (comma-separated) for production deployments
# EXTRA_FRONTEND_ORIGINS=https://warranty-radar.vercel.app,https://your-custom-domain.com


# ── Option A: Twilio WhatsApp Sandbox (no Facebook account or credit card) ───
# Sign up at https://twilio.com -> Messaging -> Try it out -> Send a WhatsApp message
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_WHATSAPP_NUMBER=14155238886
# TWILIO_SANDBOX_JOIN_CODE=join word-word
# TWILIO_WEBHOOK_URL=https://warranty-agent.onrender.com/whatsapp/twilio-webhook

# ── Option B: Meta WhatsApp Business Cloud API (production, needs Facebook) ──
# Create a Meta App -> WhatsApp -> API Setup in developers.facebook.com
# WHATSAPP_ACCESS_TOKEN=EAAG...
# WHATSAPP_PHONE_NUMBER_ID=123456789012345
# WHATSAPP_APP_SECRET=your-meta-app-secret
# WHATSAPP_VERIFY_TOKEN=choose-any-random-verification-string
# WHATSAPP_BOT_NUMBER=919876543210
# WHATSAPP_GRAPH_VERSION=v21.0

# ── Forward-to-email (optional — users forward bills to bills+<token>@your-domain) ─
# See infra/cloudflare-email-worker/README.md. Both values are required to enable it.
# INBOUND_EMAIL_DOMAIN=warrantyagent.in
# INBOUND_EMAIL_SECRET=a-long-random-string-shared-with-the-cloudflare-worker
